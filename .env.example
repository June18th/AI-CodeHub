# ========== MySQL ==========
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=aicodehub
MYSQL_USER=aicodehub
MYSQL_PASSWORD=aicodehub123
MYSQL_PORT=3306                 # MySQL 数据库端口

# ========== Redis ==========
REDIS_PASSWORD=redis123
REDIS_PORT=6379                 # Redis 缓存端口

# ========== 服务端口 ==========
BACKEND_PORT=8080               # Spring Boot 后端端口
FRONTEND_PORT=3000              # Nginx HTTPS 端口
ES_PORT=9200                    # Elasticsearch 端口
MINIO_API_PORT=9000             # MinIO API 端口
MINIO_CONSOLE_PORT=9001         # MinIO 控制台端口
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
KAFKA_PORT=9092                 # Kafka 消息队列端口

# ========== AI 模型配置 ==========
# GPT (OpenAI)
AI_GPT_API_KEY=
AI_GPT_BASE_URL=https://api.openai.com/v1
AI_GPT_MODEL=gpt-3.5-turbo

# 智谱 GLM
AI_ZHIPU_API_KEY=
AI_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_ZHIPU_MODEL=glm-4-flash

# 通义千问
AI_QWEN_API_KEY=
AI_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_QWEN_MODEL=qwen-turbo

# DeepSeek
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AI_DEEPSEEK_MODEL=deepseek-chat

# OpenAI 兼容
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_MODEL=gpt-3.5-turbo

# 高德地图 API（天气查询）
AMAP_API_KEY=

# MCP 本地 STDIO Server（可选，留空则使用内置 filesystem 工具）
# 文件系统: npx -y @modelcontextprotocol/server-filesystem /workspace
# 命令执行: npx -y @anthropic/mcp-server-commands
# 数据库:   npx -y @modelcontextprotocol/server-postgres postgresql://...
# 网络请求: npx -y @modelcontextprotocol/server-fetch
MCP_COMMAND=

# ========== Grafana ==========
GRAFANA_PORT=3100
GRAFANA_ADMIN_PASSWORD=admin

# ========== Prometheus ==========
PROMETHEUS_RETENTION=15d

# SerpAPI 联网搜索
SERPAPI_API_KEY=

# 千问 Embedding（复用千问 API Key）
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=2048
